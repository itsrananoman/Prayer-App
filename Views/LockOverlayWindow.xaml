<Window x:Class="Prayer.Views.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Prayer.ViewModels"
        mc:Ignorable="d"
        Title="Prayer Focus Lock"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Normal"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/Icons/Prayer.ico"
        Background="{StaticResource OverlayDarkBackdropBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- TOP TEST BANNER (Visible Only in Test Mode) -->
        <Border Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#2A1B05" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="0,0,0,1"
                Padding="16,8" Panel.ZIndex="100">
            <Grid MaxWidth="850">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ PREVIEW TEST MODE — " FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextGoldBrush}"/>
                    <TextBlock Text="Simulating prayer lock screen (10s timer)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✖ Close Test Mode (Esc)"
                        Style="{StaticResource PrimaryGoldButton}"
                        Command="{Binding DismissTestCommand}"
                        Padding="14,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- MAIN RESPONSIVE VIEWBOX TO FIT ALL SCREEN RESOLUTIONS & DPI SCALES -->
        <Viewbox Stretch="Uniform" Margin="24">
            <Grid Width="780" Margin="0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Mosque / Crescent Icon & Prayer Title -->
                    <RowDefinition Height="Auto"/> <!-- Countdown Clock & Progress -->
                    <RowDefinition Height="Auto"/> <!-- Daily Ayat / Hadith Card -->
                    <RowDefinition Height="Auto"/> <!-- Status & Unlock Button -->
                </Grid.RowDefinitions>

                <!-- ROW 0: PRAYER TITLE & ICON -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <!-- High-Res App Icon -->
                    <Image Source="pack://application:,,,/Resources/Icons/Prayer.ico"
                           Width="46" Height="46"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="حَيَّ عَلَى الصَّلَاةِ • حَيَّ عَلَى الْفَلَاحِ"
                               FontSize="22" FontWeight="Bold"
                               FontFamily="{StaticResource ArabicFontFamily}"
                               Foreground="{StaticResource TextGoldBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding PrayerTitle}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ROW 1: COUNTDOWN CLOCK -->
                <Border Grid.Row="1" Background="#0C261F" BorderBrush="{StaticResource BorderGoldBrush}"
                        BorderThickness="1.5" CornerRadius="14" Padding="24,14" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="LOCK TIME REMAINING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding FormattedTime}"
                                   FontSize="52" FontWeight="Bold"
                                   FontFamily="{StaticResource ClockFontFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,6"/>

                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1"
                                     Height="5" Width="320"
                                     Background="#051410" Foreground="{StaticResource AccentGoldSolidBrush}"
                                     BorderThickness="0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ROW 2: DAILY AYAT / HADITH CARD -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="18,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DailyVerse.Type, StringFormat='{}DAILY {0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DailyVerse.Reference}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}"/>
                        </Grid>

                        <!-- Arabic -->
                        <TextBlock Text="{Binding DailyVerse.ArabicText}"
                                   FontSize="18" FontWeight="Medium"
                                   FontFamily="{StaticResource ArabicFontFamily}"
                                   Foreground="{StaticResource TextGoldBrush}"
                                   TextAlignment="Right" LineHeight="28"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- Urdu -->
                        <TextBlock Text="{Binding DailyVerse.TranslationUrdu}"
                                   FontSize="14" FontFamily="{StaticResource UrduFontFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Right" LineHeight="22"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <!-- English -->
                        <TextBlock Text="{Binding DailyVerse.TranslationEnglish}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" FontStyle="Italic" LineHeight="16" Margin="0,0,0,4"/>

                        <!-- Source Attribution -->
                        <TextBlock Text="{Binding DailyVerse.SourceAttribution}"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- ROW 3: STATUS & UNLOCK BUTTON -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13" FontFamily="{StaticResource UrduFontFamily}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- 'Maine Namaz Parh Li' Button (Visible Only When CanUnlock is True) -->
                    <Button Content="✓ میں نے نماز پڑھ لی (Maine Namaz Parh Li)"
                            Command="{Binding UnlockCommand}"
                            Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryGoldButton}"
                            FontSize="16" FontWeight="Bold"
                            Padding="32,12" HorizontalAlignment="Center">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.6" Color="#E5C158"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
