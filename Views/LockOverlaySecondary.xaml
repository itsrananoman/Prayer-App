<Window x:Class="Prayer.Views.LockOverlaySecondary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Prayer Lock Secondary"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Normal"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/Icons/Prayer.ico"
        Background="{StaticResource OverlayDarkBackdropBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <!-- App Icon -->
            <Image Source="pack://application:,,,/Resources/Icons/Prayer.ico"
                   Width="64" Height="64"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="حَيَّ عَلَى الصَّلَاةِ"
                       FontSize="36" FontWeight="Bold"
                       FontFamily="{StaticResource ArabicFontFamily}"
                       Foreground="{StaticResource TextGoldBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Salah Focus Lock Active"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Please refer to the primary screen to complete prayer confirmation."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
