<UserControl x:Class="Prayer.Views.Pages.QuranPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource MainFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- 1. SURAH DIRECTORY VIEW (When not reading) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReading}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Search & Title Bar -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#0C2B22" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="{StaticResource GeoQuran}" Stroke="{StaticResource TextGoldBrush}" StrokeThickness="1.5"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="The Noble Qur'an" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="القرآن الكريم • 114 Surahs" FontSize="12" Foreground="{StaticResource TextGoldBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Input -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ThemedSearchBox}"/>
                        <TextBlock Text="🔍 Search surah name..."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Surah Grid List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredSurahs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="265" Height="90" Margin="0,0,12,12"
                                    Background="{StaticResource SurfaceCardBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14,10"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenSurahCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#143D32"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentGoldSolidBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Surah Number Badge -->
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#092019" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- English Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EnglishName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding EnglishNameTranslation}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="#0D3025" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding RevelationType}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextMintBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding NumberOfAyahs, StringFormat='{}{0} Ayahs'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Arabic Name -->
                                    <TextBlock Grid.Column="2" Text="{Binding ArabicName}" FontFamily="{StaticResource ArabicFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 2. SURAH READER VIEW (When reading a Surah) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Reader Header -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="← Back to Surahs" Style="{StaticResource SecondaryEmeraldButton}"
                            Command="{Binding BackToListCommand}" Padding="12,6" FontSize="12"/>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSurah.EnglishName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" • " FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SelectedSurah.ArabicName}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource ArabicFontFamily}" Foreground="{StaticResource TextGoldBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedSurah.EnglishNameTranslation, StringFormat='{}{0}'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Bookmark Status / Ayah Count Badge -->
                    <Border Grid.Column="2" Background="#092019" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <TextBlock Text="{Binding SelectedSurah.NumberOfAyahs, StringFormat='Total Ayahs: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Offline Notice (if any) -->
            <Border Grid.Row="1" Background="#331000" BorderBrush="#D35400" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OfflineNotice}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OfflineNotice, Converter={x:Null}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding OfflineNotice}" FontSize="13" Foreground="#FFCC80" TextAlignment="Center"/>
            </Border>

            <!-- Ayah Scrollable Content List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,16">

                    <!-- Bismillah Banner for surahs other than Surah At-Tawbah -->
                    <Border Background="#061A14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20,12" Margin="0,0,0,14">
                        <TextBlock Text="بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
                                   FontFamily="{StaticResource ArabicFontFamily}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextGoldBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CurrentAyahs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,10" Padding="16,14">
                                    <StackPanel>
                                        <!-- Top Ayah Header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Ayah Number Emblem -->
                                            <Border Background="#092019" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                                <TextBlock Text="{Binding AyahNumber, StringFormat='Ayah {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}"/>
                                            </Border>

                                            <!-- Bookmark Button -->
                                            <Button Grid.Column="2" Content="🔖 Bookmark" Style="{StaticResource OutlineButton}"
                                                    Command="{Binding DataContext.BookmarkAyahCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" FontSize="10.5"/>
                                        </Grid>

                                        <!-- Arabic Uthmani Text -->
                                        <TextBlock Text="{Binding ArabicText}"
                                                   FontFamily="{StaticResource ArabicFontFamily}"
                                                   FontSize="22" FontWeight="Medium"
                                                   Foreground="{StaticResource TextGoldBrush}"
                                                   TextWrapping="Wrap" LineHeight="38"
                                                   TextAlignment="Right" FlowDirection="RightToLeft"
                                                   Margin="0,0,0,12"/>

                                        <!-- Urdu Translation (Fateh Muhammad Jalandhry) -->
                                        <TextBlock Text="{Binding UrduText}"
                                                   FontFamily="{StaticResource UrduFontFamily}"
                                                   FontSize="16.5" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="30"
                                                   TextAlignment="Right" Margin="0,0,0,8"/>

                                        <!-- English Translation (Saheeh International) -->
                                        <TextBlock Text="{Binding EnglishText}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
