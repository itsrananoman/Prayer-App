<UserControl x:Class="Prayer.Views.Pages.HadithPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,16">

            <!-- Page Title Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📜" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Daily Hadith Inspiration" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Verified Authentic Narrations • Sahih al-Bukhari &amp; Sahih Muslim" FontSize="12" Foreground="{StaticResource TextGoldBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Large Featured Hadith Card -->
            <Border Style="{StaticResource ModernCard}" Padding="24,20" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Citation Badge -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#123B30" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" CornerRadius="6" Padding="12,5">
                            <TextBlock Text="{Binding CurrentVerse.Reference}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓ Verified Authentic" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMintBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Arabic Text -->
                    <Border Background="#071B15" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                        <TextBlock Text="{Binding CurrentVerse.ArabicText}"
                                   FontFamily="{StaticResource ArabicFontFamily}"
                                   FontSize="22" FontWeight="Medium"
                                   Foreground="{StaticResource TextGoldBrush}"
                                   TextWrapping="Wrap" LineHeight="40"
                                   TextAlignment="Center" FlowDirection="RightToLeft"/>
                    </Border>

                    <!-- Urdu Translation -->
                    <TextBlock Text="اردو ترجمہ:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" TextAlignment="Right" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentVerse.UrduTranslation}"
                               FontFamily="{StaticResource UrduFontFamily}"
                               FontSize="17" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="32"
                               TextAlignment="Right" Margin="0,0,0,16"/>

                    <!-- English Translation -->
                    <TextBlock Text="English Translation:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentVerse.EnglishTranslation}"
                               FontStyle="Italic" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20"/>

                    <!-- Source Attribution Footer -->
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <TextBlock Text="{Binding CurrentVerse.SourceAttribution, StringFormat='Source: {0}'}"
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
