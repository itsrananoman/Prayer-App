<UserControl x:Class="Prayer.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource MainFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,16">

            <!-- 1. HERO NEXT PRAYER CARD (Continuous gold accent border + seamless feathered mosque artwork) -->
            <Border x:Name="HeroCardOuterBorder"
                    Margin="0,0,0,16" Height="195"
                    CornerRadius="16"
                    BorderBrush="{StaticResource AccentGoldSolidBrush}"
                    BorderThickness="1.5"
                    Background="{StaticResource SurfaceCardBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                </Border.Effect>

                <!-- Inner Container with Rounded Corner Mask (outer gold border is 100% visible and unclipped) -->
                <Border CornerRadius="14.5">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border CornerRadius="14.5"
                                        Width="{Binding ActualWidth, ElementName=HeroCardOuterBorder}"
                                        Height="{Binding ActualHeight, ElementName=HeroCardOuterBorder}"
                                        Background="Black"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>

                    <Grid>
                        <!-- Base Card Background -->
                        <Border Background="#0C261F"/>

                        <!-- Mosque Sunset Backdrop Image on Right with Seamless Pre-Feathered Left Edge -->
                        <Image Source="pack://application:,,,/Resources/Images/mosque_hero_banner.png"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                               Stretch="UniformToFill" Width="580"/>

                        <!-- Hero Content Grid -->
                        <Grid Margin="26,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Info -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Next Prayer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}" Margin="0,0,0,4"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding NextPrayerName}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="  " FontSize="28"/>
                                    <TextBlock Text="{Binding NextPrayerUrduName}" FontSize="32" FontWeight="Bold" FontFamily="{StaticResource ArabicFontFamily}" Foreground="{StaticResource TextGoldBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding NextPrayerCountdown}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" remaining" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                                </StackPanel>

                                <!-- Glowing Countdown Progress Bar -->
                                <Border Width="300" Height="6" Background="#0A1F19" CornerRadius="3" HorizontalAlignment="Left">
                                    <ProgressBar Value="{Binding CountdownProgress, Mode=OneWay}" Minimum="0" Maximum="1"
                                                 Height="6" Background="Transparent" Foreground="{StaticResource AccentGoldSolidBrush}"
                                                 BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Top-Right Scheduled At Badge -->
                            <Border Grid.Column="1" VerticalAlignment="Top" Background="#55000000" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Clock Vector Icon -->
                                    <Path Data="{StaticResource GeoClock}" Stroke="{StaticResource TextGoldBrush}" StrokeThickness="1.8"
                                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Scheduled At" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding NextPrayerTargetTime}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- 2. 5 PRAYER TIME CARDS WITH VECTOR ICONS -->
            <ItemsControl ItemsSource="{Binding PrayerCards}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,0" CornerRadius="14" Padding="12,16" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#000000"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                            <Setter Property="Background" Value="#123B30"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGoldSolidBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#D4AF37"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource TextMintBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center">
                                <!-- Circular Icon Badge with Pure Vector Path -->
                                <Border Width="44" Height="44" CornerRadius="22" Background="#0C2820" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Path Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{StaticResource TextGoldBrush}"/>
                                                <Setter Property="StrokeThickness" Value="1.6"/>
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Sunrise">
                                                        <Setter Property="Data" Value="{StaticResource GeoFajr}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Mosque">
                                                        <Setter Property="Data" Value="{StaticResource GeoDhuhr}"/>
                                                        <Setter Property="Fill" Value="{StaticResource TextGoldBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Sun">
                                                        <Setter Property="Data" Value="{StaticResource GeoAsr}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Sunset">
                                                        <Setter Property="Data" Value="{StaticResource GeoMaghrib}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Moonrise">
                                                        <Setter Property="Data" Value="{StaticResource GeoMaghrib}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}" Value="Moon">
                                                        <Setter Property="Data" Value="{StaticResource GeoIsha}"/>
                                                        <Setter Property="Fill" Value="{StaticResource TextGoldBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <!-- Prayer Name -->
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding UrduName}" FontSize="13" FontFamily="{StaticResource ArabicFontFamily}" Foreground="{StaticResource TextGoldBrush}" HorizontalAlignment="Center" Margin="0,1,0,8"/>

                                <!-- Prayer Time -->
                                <TextBlock Text="{Binding FormattedTime}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <!-- Status Badge -->
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#092019"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="Background" Value="#2A4839"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="#114436"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextGoldBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMintBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. DAILY INSPIRATION (HADITH / AYAT) CARD -->
            <Border Style="{StaticResource ModernCard}" Padding="20,18">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Inspiration Badge with Vector Icon -->
                        <Border Background="#123B30" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHadith}" Fill="{StaticResource TextGoldBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Hadith" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="1" Text="Daily Inspiration • روزانہ کا پیغام" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <!-- Citation -->
                        <TextBlock Grid.Column="2" Text="{Binding TodayVerse.Reference}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Arabic Text -->
                    <Border Background="#071B15" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TodayVerse.ArabicText}"
                                   FontFamily="{StaticResource ArabicFontFamily}"
                                   FontSize="20" FontWeight="Medium"
                                   Foreground="{StaticResource TextGoldBrush}"
                                   TextWrapping="Wrap" LineHeight="34"
                                   TextAlignment="Center" FlowDirection="RightToLeft"/>
                    </Border>

                    <!-- Urdu Translation -->
                    <TextBlock Text="{Binding TodayVerse.UrduTranslation}"
                               FontFamily="{StaticResource UrduFontFamily}"
                               FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="28"
                               TextAlignment="Right" Margin="0,0,0,10"/>

                    <!-- English Translation -->
                    <TextBlock Text="{Binding TodayVerse.EnglishTranslation}"
                               FontStyle="Italic" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

                    <!-- Attribution & Verification Footer -->
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TodayVerse.SourceAttribution, StringFormat='Source: {0}'}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓ Verified Authentic" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMintBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
