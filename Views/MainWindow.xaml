<Window x:Class="Prayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Prayer.ViewModels"
        xmlns:pages="clr-namespace:Prayer.Views.Pages"
        mc:Ignorable="d"
        Title="Prayer — Focus • Salah • Consistency"
        Height="780" Width="1160" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Resources/Icons/Prayer.ico"
        FontFamily="{StaticResource MainFontFamily}">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataTemplates for Page Navigation -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <pages:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrayerTimesViewModel}">
            <pages:PrayerTimesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuranViewModel}">
            <pages:QuranPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HadithViewModel}">
            <pages:HadithPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <pages:AboutPage/>
        </DataTemplate>
    </Window.Resources>

    <!-- MAIN SHELL GRID -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/> <!-- Top Header Bar -->
            <RowDefinition Height="*"/>   <!-- Main Content with Sidebar -->
            <RowDefinition Height="38"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="#061A14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Branding with Pure Vector Mosque Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#0C2B22" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoAppLogo}" Fill="{StaticResource TextGoldBrush}"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PRAYER" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}"/>
                            <TextBlock Text=" • " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="صلوٰۃ" FontSize="14.5" FontWeight="Bold" FontFamily="{StaticResource ArabicFontFamily}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Focus • Salah • Consistency" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Location Badge & Date Display -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Location Pill -->
                    <Border Background="#0C2B22" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLocation}" Fill="{StaticResource TextGoldBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding HomeViewModel.LocationDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Date Display -->
                    <TextBlock Text="{Binding HomeViewModel.CurrentDateDisplay}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Window Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Minimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore">
                        <Rectangle Width="9" Height="9" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick" ToolTip="Close to Tray"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN BODY (SIDEBAR + CONTENT) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Background="#071D17" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation Items List with Vector Icons -->
                    <StackPanel Grid.Row="0">
                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHome}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsPrayerTimesSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="PrayerTimes">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPrayerTimes}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Prayer Times" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsQuranSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Quran">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoQuran}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quran" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsHadithSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Hadith">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHadith}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hadith" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarNavRadioButton}"
                                     IsChecked="{Binding IsAboutSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoAbout}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom-Left Daily Quote Widget with Vector Heart Icon -->
                    <Border Grid.Row="1" Background="#0C2920" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,14">
                        <StackPanel>
                            <Path Data="{StaticResource GeoHeart}" Fill="{StaticResource TextGoldBrush}"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding HomeViewModel.DailyQuoteText, StringFormat='&quot;{0}&quot;'}"
                                       FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="16" TextAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding HomeViewModel.DailyQuoteSource}"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGoldBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Column="1" Padding="18,16,18,0">
                <ContentControl Content="{Binding CurrentPageViewModel}"/>
            </Border>
        </Grid>

        <!-- ==================== 3. BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="#051410" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text with Vector Lock -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoLock}" Fill="{StaticResource TextGoldBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LockStatusText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live Digital Time Clock -->
                <Border Grid.Column="2" Background="#0A221A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HomeViewModel.CurrentTimeDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextGoldBrush}"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
